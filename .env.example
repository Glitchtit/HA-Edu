# Home Assistant Educational Portal Configuration

# Base port for Home Assistant instances (default: 8123)
BASE_PORT=8123

# Maximum number of concurrent instances (default: 15)
MAX_INSTANCES=15

# Path to store instance data (default: /data/instances.json)
DATA_FILE=/data/instances.json

# Home Assistant Docker image to use
HA_IMAGE=ghcr.io/home-assistant/home-assistant:stable
