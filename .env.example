# Home Assistant Educational Portal Configuration

# Base port for Home Assistant instances (default: 8123)
# Ports are assigned dynamically starting from this value
BASE_PORT=8123

# Path to store instance data (default: /data/instances.json)
DATA_FILE=/data/instances.json

# Path to store interaction logs (default: /logs)
# Logs include instance creation, deletion, access, and admin operations
LOG_DIR=/logs

# Home Assistant Docker image to use
HA_IMAGE=ghcr.io/home-assistant/home-assistant:stable

# Admin password for managing all instances (optional)
# If set, enables reset functionality with admin authentication
ADMIN_PASSWORD=

# Teacher Access Configuration (optional)
# If both are set, enables "Teacher Access" feature to add teacher admin accounts
# to student instances after they complete onboarding
TEACHER_USERNAME=
TEACHER_PASSWORD=

# Admin Email Addresses (optional)
# Comma-separated list of email addresses for users who should have admin access
# when authenticated via Cloudflare Zero Trust
# Example: ADMINS=admin@example.com,teacher@example.com
ADMINS=

# Maximum number of instances non-admin users can create (optional)
# If not set or set to 0, non-admin users have unlimited instances
# Admins always have unlimited instances regardless of this setting
# Example: MAX_INSTANCES=1 (limits each non-admin user to 1 instance)
MAX_INSTANCES=

# Onboarding status cache TTL in seconds (optional, default: 60)
# How long to cache instance onboarding status checks for admin views
# Lower values provide fresher data but may impact performance with many instances
# Example: ONBOARDING_CACHE_TTL=120 (cache for 2 minutes)
ONBOARDING_CACHE_TTL=60

# Docker host IP for accessing instance containers (required when running in Docker)
# Use 'host.docker.internal' on Docker Desktop (Mac/Windows)
# Use 'gateway.docker.internal' on Linux with Docker 20.10+
# Use 'localhost' when running the portal directly on the host (not in Docker)
# Or set to the host's IP address (e.g., 192.168.1.10) if needed
DOCKER_HOST_IP=host.docker.internal

# Network Configuration:
# - Instances run in isolated bridge network mode
# - Internet access: YES (via NAT)
# - LAN access: NO (isolated from host network)
# - Access via Cloudflare tunnel (e.g., edu.wredlund.fi) for external connectivity
